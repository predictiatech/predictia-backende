// FILE: ai-service/index.js (COMPLETO) — Service B (Gemini Receiver)
// Rota: POST /ai/analyze  -> recebe iaPayload e retorna texto final
// ENV: GEMINI_API_KEY, GEMINI_MODEL (opcional), AI_SHARED_SECRET (opcional)

import "dotenv/config";
import express from "express";
import cors from "cors";
import crypto from "crypto";
import { GoogleGenerativeAI } from "@google/generative-ai";

const app = express();
app.use(cors());
app.use(express.json({ limit: "1mb" }));

// ---------------- ENV ----------------
const GENAI_KEY = process.env.GEMINI_API_KEY;
const GENAI_MODEL = (process.env.GEMINI_MODEL || "gemini-2.5-flash").trim();
const AI_SHARED_SECRET = (process.env.AI_SHARED_SECRET || "").trim(); // opcional: segurança simples

if (!GENAI_KEY) {
  console.error("FALTA GEMINI_API_KEY");
}

// ---------------- Helpers ----------------
function safeJsonStringify(obj) {
  try {
    return JSON.stringify(obj);
  } catch {
    return "{}";
  }
}

function hasForbiddenQuarterHandicap(handicap) {
  if (handicap === null || handicap === undefined) return false;
  const s = String(handicap).trim();
  // bloqueia qualquer .25 ou .75 em qualquer lugar (ex: 1.25, -0.75)
  return s.includes(".25") || s.includes(".75");
}

function buildPredictIAPrompt(iaPayload) {
  // OBS: Aqui você injeta o JSON "como está".
  // Você pode substituir {COLE...} por stringify do payload.
  const payloadStr = safeJsonStringify(iaPayload);

  return `Você é o PredictIA (analista humano de apostas ao vivo). Você NÃO pode inventar dados. Você só pode usar os dados fornecidos em "IA_PAYLOAD". Se faltar informação, você deve tomar decisão apenas entre as oportunidades já listadas (recomendação e alternativas), sem criar mercados/linhas/odds.

════════════════════════════════════
OBJETIVO
════════════════════════════════════
Gerar 1 palpite final (apenas 1), baseado EXCLUSIVAMENTE no IA_PAYLOAD, priorizando:
1) EV matemático positivo (EV = Probabilidade × Odd - 1)
2) Probabilidade de green
3) Risco mais baixo possível dado o estado do jogo

════════════════════════════════════
PROIBIÇÕES ABSOLUTAS
════════════════════════════════════
- Proibido inventar estatísticas, odds, xG, cantos, cartões, placar, minuto, times, ou qualquer dado.
- Proibido sugerir mercados/linhas que não estejam presentes em IA_PAYLOAD.
- Proibido usar handicap fracionado 1.25, 1.75 (e quaisquer “.25” ou “.75”). Se aparecer, descarte essa opção e use a próxima alternativa.
- Proibido Markdown. Apenas texto simples.

════════════════════════════════════
TRAVAS (ANTI-PEGADINHA) — OBRIGATÓRIAS
════════════════════════════════════
Você deve VALIDAR a recomendação principal e, se falhar em qualquer trava, você deve automaticamente escolher a próxima alternativa (na ordem apresentada). Se todas falharem, escolha a opção com MAIOR probabilidade entre as opções disponíveis (ainda respeitando as proibições).

TRAVA 1 — Minuto mínimo:
- Se matchMinute < 15, ainda assim você deve escolher entre as opções fornecidas (sem inventar), mas marque o risco como "alto".

TRAVA 2 — Mercado de gols 0.5 por minuto:
- Se o mercado for "Over 0.5" e matchMinute <= 30, DESCARTE.
- Se o mercado for "Under 0.5" e matchMinute >= 40, DESCARTE.
(Se a linha não for 0.5, ignore esta trava.)

TRAVA 3 — Coerência do Under/Over com gols já marcados:
- Se for Under (ex.: Under 2.5) e totalGoals já estiver acima do limite possível, DESCARTE.
- Se for Over e já estiver matematicamente garantido, pode manter (risco tende a ser baixo), mas não altere números.

TRAVA 4 — Pressão ofensiva contra Under (regra simples com dados existentes):
Para mercados UNDER (gols/cantos/cartões):
- Se shots.total.onTarget >= 7 OU corners.total >= 8 no momento, marque risco como "alto".

TRAVA 5 — Cartões Under com faltas altas:
- Se mercado for Cartões Under e fouls.total >= 28, marque risco como "alto".

════════════════════════════════════
COMO ESCOLHER (PROTOCOLO)
════════════════════════════════════
1) Considere primeiro IA_PAYLOAD.recommendation.
2) Aplique PROIBIÇÕES e TRAVAS.
3) Se falhar: tente IA_PAYLOAD.alternatives[0], depois [1], etc.
4) Você NÃO pode criar uma quarta opção fora das fornecidas.
5) Risco:
   - baixo: prob >= 0.70 e sem travas de pressão acionadas
   - médio: prob 0.60–0.69 OU 1 trava de pressão acionada
   - alto: prob < 0.60 OU minuto < 15 OU 2+ travas de pressão acionadas

════════════════════════════════════
REGRAS DE SAÍDA (FORMATO ESTRITO)
════════════════════════════════════
- Idioma: PT-BR
- Máximo 6 linhas
- Sem listas, sem aspas, sem texto extra

FORMATO OBRIGATÓRIO (6 linhas):
Recomendação: <mercado + linha + período> (ALVO: JOGO|CASA|FORA)
Odd: <X.XX>
Probabilidade de Green: <XX%>
EV: <+0.0000>
Risco: baixo|médio|alto
Justificativa: <1 frase citando 2 sinais do payload: minuto/placar + (SOT/cantos/cartões/faltas/posse) e conectando ao EV>

════════════════════════════════════
IA_PAYLOAD (DADOS REAIS)
════════════════════════════════════
${payloadStr}`;
}

function verifySharedSecret(req) {
  if (!AI_SHARED_SECRET) return true; // se não setou, não valida
  const provided = String(req.headers["x-ai-secret"] || "");
  return provided && crypto.timingSafeEqual(Buffer.from(provided), Buffer.from(AI_SHARED_SECRET));
}

// ---------------- Gemini client ----------------
const genAI = GENAI_KEY ? new GoogleGenerativeAI(GENAI_KEY) : null;

async function callGemini(prompt) {
  if (!genAI) throw new Error("GEMINI_API_KEY ausente no Service B");

  const model = genAI.getGenerativeModel({ model: GENAI_MODEL });
  const result = await model.generateContent(prompt);

  const text = result?.response?.text?.() || "";
  return text.trim();
}

// ---------------- Routes ----------------
app.get("/health", (_req, res) => {
  res.json({
    ok: true,
    service: "ai-service",
    hasGeminiKey: !!GENAI_KEY,
    model: GENAI_MODEL,
    timestamp: new Date().toISOString(),
    sharedSecretEnabled: !!AI_SHARED_SECRET,
  });
});

app.post("/ai/analyze", async (req, res) => {
  try {
    if (!verifySharedSecret(req)) {
      return res.status(401).json({ ok: false, error: "Unauthorized (bad x-ai-secret)" });
    }

    const { iaPayload } = req.body || {};
    if (!iaPayload) {
      return res.status(400).json({ ok: false, error: "iaPayload is required" });
    }

    // Bloqueio rápido de handicap .25/.75 já aqui (antes do Gemini)
    const rec = iaPayload?.recommendation || {};
    if (hasForbiddenQuarterHandicap(rec?.handicap)) {
      // Não inventa: apenas marca que a recomendação principal está proibida.
      // Gemini vai tentar alternativas conforme prompt, mas aqui já sinalizamos.
      iaPayload.recommendation.confidence = "BLOCKED_QUARTER_HANDICAP";
    }

    const prompt = buildPredictIAPrompt(iaPayload);
    const text = await callGemini(prompt);

    // Saída mínima: texto e metadados úteis
    return res.json({
      ok: true,
      fixtureId: iaPayload?.matchInfo?.fixtureId ?? null,
      minute: iaPayload?.matchInfo?.minute ?? null,
      text,
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      error: "AI service failed",
      details: error?.message || String(error),
    });
  }
});

// ---------------- Server ----------------
const PORT = process.env.PORT || 11000;

app.listen(PORT, () => {
  console.log(`AI Service (Gemini) rodando na porta ${PORT}`);
  console.log("ROTAS:");
  console.log("GET  /health");
  console.log("POST /ai/analyze");
});
